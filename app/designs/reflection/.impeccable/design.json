{
  "narrative": {
    "dos": [
      "**Do** 保留白色共享壳层与手机现有底栏。",
      "**Do** 保留全部五字段、日期、成绩入口、历史库和真实失败恢复。",
      "**Do** 以实际渲染、源码和保存确认区分设计方向与运行事实。",
      "**Do** 让长内容和末字段可滚动到固定动作栏上方。"
    ],
    "rules": [
      {
        "name": "The Evidence Rule",
        "body": "源码和实际行为优先于生成图中的导航、字体、字数和分页示意；技术 PASS 只表示可交审。",
        "section": "overview"
      },
      {
        "name": "The Context Color Rule",
        "body": "色块必须指向考试、选择、行动或状态，不用彩色容器重复包装五个字段。",
        "section": "colors"
      },
      {
        "name": "The Readable Writing Rule",
        "body": "手机输入使用 mobile-field；长内容自然换行并滚动，不能通过删字段或缩小整页维持首屏。",
        "section": "typography"
      },
      {
        "name": "The Continuous Work Rule",
        "body": "桌面选择与编辑并列，手机一次只处理一个学生；五字段、日期、保存和返回构成同一工作流。",
        "section": "layout"
      },
      {
        "name": "The In-place Feedback Rule",
        "body": "正常保存通过按钮忙碌态和原位状态呈现；失败和冲突保留明确错误、重试和恢复入口。",
        "section": "elevation & depth"
      }
    ],
    "keyCharacteristics": [
      "桌面队列与连续填写并排，手机队列进入独立编辑。",
      "薄荷绿标记考试上下文，浅蓝强调下一步行动。",
      "保存结果原位反馈，真正失败提供恢复动作。",
      "历史库按反思记录保留跨考试与未关联内容。"
    ],
    "northStar": "把下一步写进复盘本",
    "donts": [
      "**Don't** 将 C01 方向确认或 finish PASS 写成 P01 用户审美批准。",
      "**Don't** 按当前考试过滤掉全班历史库中的未关联记录。",
      "**Don't** 用生成图的深色导航、字体、字数或分页数覆盖现有实现。",
      "**Don't** 为每次正常保存插入恢复横条，或把归档描述成自动发送家长。"
    ],
    "overview": "考试与学生先提供具体上下文，老师在连续工作面中把问题、原因和行动写清楚。白色工作台、海军蓝文字、薄荷绿考试区与浅蓝行动区保持清楚的阅读顺序；笔记本插画为记录工作提供温和的主题线索。\n\n这是本页 P01 的实施记录，范围只到 `app/designs/reflection` 及隔离预览，不替代根目录 DESIGN.md，不定义全站新主题。命名与气氛描述由文档整理者据现有实现归纳，并非额外取得用户创意批准。"
  },
