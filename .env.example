ADMIN_KEY=replace-with-admin-secret
ADMIN_ALLOWED_IPS=127.0.0.1
AUTH_ENFORCEMENT_ENABLED=true
# Production: false. Enable only for a temporary local/HTTP test environment.
AUTH_ALLOW_INSECURE_HTTP=false
# Set true only when the app is behind your own configured reverse proxy.
AUTH_TRUST_PROXY_HEADERS=false
AUTH_SESSION_SECRET=replace-with-at-least-24-random-characters
REDEEM_CODE_SECRET=replace-with-at-least-24-random-characters
CLASSROOM_DB_PATH=data/classroom.db
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# Optional exam-paper parser adapter. Keep both values on the server only.
# The adapter receives multipart form data and returns { items: [{ title, subject?, questionNo?, knowledgePoint?, questionType?, maxScore, confidence? }] }.
EXAM_AI_ENDPOINT=
EXAM_AI_API_KEY=
